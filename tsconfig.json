{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"strict": true,
		"noImplicitAny": true,
		"noUncheckedIndexedAccess": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"verbatimModuleSyntax": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"lib": ["DOM", "ES5", "ES6", "ES7"],
		"jsx": "react-jsx",
		// Pinned so a removed transitive @types package cannot break the build
		// via the implicit global type-library scan.
		"types": ["node"]
	},
	"include": ["**/*.ts", "**/*.tsx"]
}
